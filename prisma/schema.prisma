datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  display_name     String?
  avatar_url       String?
  shipping_address Json?         // For storing shipping address details
  role             Role          @default(USER)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  sessions         AuthSession[]
  comments         Comment[]
  reactions        Reaction[]
  orders           Order[]
}

model AuthSession {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model VerificationToken {
  id            String   @id @default(uuid())
  email         String
  otp_code_hash String   // Hashed 6-digit OTP code
  token         String   @unique // Secure token for the clickable magic link
  expires_at    DateTime
  created_at    DateTime @default(now())
}

model Post {
  id                     String     @id @default(uuid())
  slug                   String     @unique
  title                  String
  content_json           Json       // Rich text TipTap blocks stored as JSON
  is_published           Boolean    @default(false)
  gated_tier_requirement String?    // Null means public, otherwise maps to InventoryItem.id
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  comments               Comment[]
  reactions              Reaction[]
}

model Comment {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id    String
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  block_id   String    // Maps to the specific TipTap block data-block-id
  text       String
  parent_id  String?
  parent     Comment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Reaction {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id    String
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  block_id   String   // Maps to the specific TipTap block data-block-id
  emoji      String   // E.g., 🔥, 👍, 💡
  created_at DateTime @default(now())

  @@unique([user_id, post_id, block_id, emoji])
}

model InventoryItem {
  id              String     @id @default(uuid())
  name            String
  type            String     // "digital" or "physical"
  price           Int        // Price in cents
  stock_allocated Int        @default(0)
  max_limit       Int?       // Null means unlimited availability
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  line_items      LineItem[]
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id              String      @id @default(uuid())
  user_id         String
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  total_amount    Int         // Total in cents
  stripe_intent_id String?     @unique
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  line_items      LineItem[]
  ledger_entries  Ledger[]
}

model LineItem {
  id         String        @id @default(uuid())
  order_id   String
  order      Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  item_id    String
  item       InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  price_paid Int           // The price paid at transaction time in cents
}

enum LedgerType {
  CHARGE
  REFUND
  UPGRADE
  DOWNGRADE
}

model Ledger {
  id         String     @id @default(uuid())
  order_id   String
  order      Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  type       LedgerType
  amount     Int        // Amount in cents (positive for charges, negative for refunds/downgrades)
  stripe_id  String     // Stripe charge, refund, or intent ID
  created_at DateTime   @default(now())
}
